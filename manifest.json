{
  "manifest_version": 3,
  "name": "Chat Reader",
  "version": "0.3.0",
  "description": "把 Claude 网页版的聊天页面变成可以批注的教材：排版、目录、标注、查词。",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-toc": {
      "suggested_key": { "default": "Alt+M" },
      "description": "显示/收起目录面板"
    }
  },
  "action": {
    "default_title": "Chat Reader",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": [
        "shared/defaults.js",
        "content/core/namespace.js",
        "content/core/utils.js",
        "content/core/page-watcher.js",
        "content/core/settings.js",
        "content/core/features.js",
        "content/adapters/claude.js",
        "content/adapters/index.js",
        "content/features/typography.js",
        "content/features/toc.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
